+    },confirmButton={TextButton({save((item ?: GearItem(name="",category=category)).copy(name=name.trim(),category=category,notes=notes.trim()))},enabled=name.isNotBlank()){Text("Save")}},
+    dismissButton={TextButton(dismiss){Text("Cancel")}})
