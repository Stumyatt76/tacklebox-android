# Copy to keystore.properties (gitignored) and fill in to build a signed release locally.
# Generate the keystore first (keeps the password out of any tracked file):
#   keytool -genkeypair -v -keystore tacklebox-release.jks \
#     -alias tacklebox -keyalg RSA -keysize 2048 -validity 10000
# Then point storeFile at it (path relative to the repo root).
storeFile=tacklebox-release.jks
storePassword=CHANGE_ME
keyAlias=tacklebox
keyPassword=CHANGE_ME
