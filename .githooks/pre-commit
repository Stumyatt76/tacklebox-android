#!/usr/bin/env bash
# Pre-commit hook: block commits that add/modify a Kotlin source file without
# the proprietary copyright header. Checks the STAGED content, not the worktree.
#
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

MARKER="All rights reserved"
missing=()

while IFS= read -r f; do
  case "$f" in
    *.kt) ;;
    *) continue ;;
  esac
  # Read the staged version of the file (":$f") — that is what is being committed.
  #
  # Captured into a variable rather than piped straight into grep. `grep -q` exits the moment it matches, which
  # SIGPIPEs the upstream `git show`; with `set -o pipefail` that non-zero status became a spurious "missing
  # header". It only ever bit on the largest file, because a small one finishes writing before grep exits, which
  # is why it survived this long.
  header=$(git show ":$f" 2>/dev/null | head -n 5 || true)
  if ! printf '%s\n' "$header" | grep -q "$MARKER"; then
    missing+=("$f")
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "${#missing[@]}" -gt 0 ]; then
  echo "✗ pre-commit: missing copyright header in staged Kotlin file(s):" >&2
  printf '  %s\n' "${missing[@]}" >&2
  echo >&2
  echo "Add above the package declaration:" >&2
  echo "  /*" >&2
  echo "   * Copyright (c) 2026 Stuart Myatt. All rights reserved." >&2
  echo "   * Proprietary — source is public for reference only. See LICENSE at the repository root." >&2
  echo "   */" >&2
  echo >&2
  echo "(To bypass in an emergency: git commit --no-verify)" >&2
  exit 1
fi
